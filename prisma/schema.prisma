// SkyHub Prisma Schema (Prisma 7)
// Connection URL is configured in prisma.config.ts, not here.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Cached player profile snapshots — avoids redundant Hypixel API calls
/// and enables historical comparison
model PlayerSnapshot {
  id          String   @id @default(cuid())
  uuid        String
  username    String
  profileId   String
  profileName String
  /// JSON-serialized PlayerProfile
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([uuid])
  @@index([username])
  @@index([updatedAt])
}

/// Records player searches for "recent searches" on landing page
model SearchHistory {
  id        String   @id @default(cuid())
  username  String
  uuid      String?
  createdAt DateTime @default(now())

  @@index([username])
  @@index([createdAt])
}
