# Hypixel API Key - get yours at https://developer.hypixel.net
HYPIXEL_API_KEY=your_hypixel_api_key_here

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/skyhub

# App
NEXT_PUBLIC_APP_NAME=SkyHub
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# Optional: Redis for caching
REDIS_URL=redis://localhost:6379

# Optional: Cache TTL in seconds (default 300)
CACHE_TTL=300
